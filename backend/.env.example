# Backend environment — copy to .env and fill in real values.
# The .env file itself is gitignored; commit only this template.

MONGO_URL=mongodb://127.0.0.1:27017/career-advisor
PORT=8000
# Change this in production and keep it secret
JWT_SECRET=change_me_to_a_long_random_string
AI_SERVICE_URL=http://127.0.0.1:5001
ALLOWED_ORIGINS=http://localhost:3000
NODE_ENV=development

# Job APIs — paste real keys to enable these sources (The Muse works keyless)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
